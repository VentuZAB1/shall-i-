// SLINGSHOT Halloween - Mist (512 px) as a real lit VOLUME (vfx.py prepends common.h; single frame).
// A wide, low, soft bank of ground mist: a flattened ellipsoid broken into soft lobes (billow) with wispy fbm edges,
// thin enough to stay translucent. Bright, slightly cool albedo; lit from above by a sun + strong sky ambient so it
// reads as pale mist in daylight. Exactly 0 before the image edge.

shader mist_volume(int frame = 0, int frames = 1, float seed = 3.3, float density = 2.6,
                   output float Density = 0, output color Albedo = 0.85)
{
    point p = transform("object", P);
    point q = point(p[0] / 0.90, p[1] / 0.46, p[2] / 0.70);
    float wx = fbm(q * 0.9 + point(0.0, 0.0, seed), 3, 0.5);
    float wy = fbm(q * 0.9 + point(4.1, 2.2, seed), 3, 0.5);
    float wz = fbm(q * 0.9 + point(8.3, 6.6, seed), 3, 0.5);
    point qw = q + 0.45 * vector(wx, wy, wz);
    float body = 1.0 - smoothstep(0.0, 1.0, length(vector(qw[0], qw[1] * (qw[1] < 0.0 ? 1.3 : 1.0), qw[2])));
    float lobes = billow(qw * 1.3 + point(seed, 0.0, 0.0), 3, 0.45);
    float wisp = fbm(point(p[0] * 5.0, p[1] * 9.0, p[2] * 5.0) + point(0.0, seed, 0.0), 4, 0.55);
    float d = body * (0.30 + 1.10 * lobes) + 0.15 * wisp - 0.30;
    Density = density * max(d, 0.0) * border(p[0], p[1], 0.12);
    Albedo = color(0.86, 0.87, 0.93);
}
