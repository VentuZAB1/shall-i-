// SLINGSHOT Halloween - Mist (512 px): a soft, wide wisp of low ground mist (vfx.py prepends common.h).
// Large-scale domain-warped noise inside a wide elliptical falloff, low contrast, very soft edges; light grey with a
// cool lavender tint, lit tops a touch brighter. Max alpha ~0.55 so several overlapping particles build up softly.
// Exactly 0 before the image edge.

float mist_density(float x, float y)
{
    point q = point(x * 1.3, y * 2.0, 2.7);
    float wx = fbm(q * 0.7 + point(0.0, 0.0, 5.0), 3, 0.5);
    float wy = fbm(q * 0.7 + point(0.0, 0.0, 11.0), 3, 0.5);
    point q2 = q + point(0.9 * wx, 0.5 * wy, 0.0);
    float b = billow(q2 * 1.1, 4, 0.45);
    float rx = (x + 0.20 * wx) / 0.82, ry = (y + 0.14 * wy) / 0.46;
    float r = hypot(rx, ry);
    float body = 1.0 - smoothstep(0.0, 1.0, r);
    return body * (0.20 + 1.05 * b) - 0.12;
}

shader mist(int mode = 0, int cols = 1, output color Out = 0)
{
    float x, y, T, frame;
    tile(transform("object", P), cols, x, y, T, frame);

    float D = mist_density(x, y);
    float Dl = mist_density(x, y + 0.05);
    float dens = smoothstep(0.0, 0.75, D);
    float lit = clamp(0.5 + 3.0 * (D - Dl), 0.0, 1.0);
    color col = mix(color(0.70, 0.70, 0.78), color(0.90, 0.90, 0.95), lit);

    float A = 0.55 * dens;
    A *= border(x, y, 0.14);

    Out = (mode == 0) ? col : color(A);
}
