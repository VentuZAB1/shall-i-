// SLINGSHOT Halloween - CandleFlame 8x8 flipbook: a seamless 64-frame loop (vfx.py prepends common.h).
// Reference (animationreference.org /tags/subtle, How To Train Your Dragon, candlelight): a tall teardrop with a
// white-yellow core, an orange body and a thin red edge; it sways gently (a slow bend travelling up the flame) and
// flickers only now and then (one strong + one weak event per loop: stretch, thin, quick wiggle, a tip that pinches off).
// Outline = a chain of round cones through 9 profile circles (full belly low down, convex sides, pointed tip).
// Every time function is periodic in T (integer harmonics, wrapped bumps, periodic noise) -> frame 63 flows into 0.

color candle_ramp(float h)
{
    float K[7] = { 0.0, 0.12, 0.30, 0.50, 0.70, 0.87, 1.0 };
    color C[7] = { color(0.66, 0.06, 0.02), color(0.95, 0.22, 0.03), color(1.0, 0.45, 0.05),
                   color(1.0, 0.63, 0.12), color(1.0, 0.80, 0.32), color(1.0, 0.92, 0.60), color(1.0, 0.98, 0.86) };
    return ramp7(h, K, C);
}

float sway_x(float T, float ev, float s)
{
    float TH = M_2PI * T;
    float sway = 0.55 * sin(TH - 2.4 * s + 0.3) + 0.30 * sin(2.0 * TH - 3.3 * s + 2.1)
               + 0.15 * sin(3.0 * TH - 4.5 * s + 4.0);
    float jit = 0.6 * sin(M_2PI * 9.0 * T - 7.0 * s) + 0.4 * sin(M_2PI * 14.0 * T - 10.0 * s + 1.0);
    return (0.065 * sway + 0.055 * ev * jit) * pow(max(s, 0.0), 1.5);
}

shader candle_flame(int mode = 0, int cols = 8, output color Out = 0)
{
    float x, y, T, frame;
    tile(transform("object", P), cols, x, y, T, frame);
    float TH = M_2PI * T;

    // occasional flicker (periodic bumps, ~0 at the loop seam): 1 strong at T 0.36, 1 weak at T 0.79
    float e1 = exp(-sq(wrapd(T, 0.36) / 0.030));
    float e2 = 0.55 * exp(-sq(wrapd(T, 0.79) / 0.022));
    float ev = e1 + e2;
    float br = 0.030 * sin(TH + 1.3) + 0.015 * sin(2.0 * TH + 0.4);      // gentle breathing

    float W = 0.212 * (1.0 - 0.5 * br) * (1.0 - 0.13 * ev);              // half width at the belly
    float L = 1.33 * (1.0 + br) * (1.0 + 0.22 * ev);                     // bottom -> tip
    float ybot = -0.84;

    // profile circles: (fraction of L of the centre, radius / W)
    float S[9] = { 0.0, 0.22, 0.38, 0.52, 0.645, 0.75, 0.845, 0.925, 1.0 };
    float R[9] = { 0.90, 1.00, 0.95, 0.81, 0.63, 0.46, 0.29, 0.14, 0.035 };
    float sd = 1e6;
    float pcx = 0, pcy = 0, pr = 0;
    for (int i = 0; i < 9; i++) {
        float r = R[i] * W;
        float cy = (i == 0) ? ybot + r : ybot + S[i] * L - ((i == 8) ? r : 0.0);
        float s = (cy - ybot) / L;
        float cx = sway_x(T, ev, s);
        if (i > 0) sd = min(sd, sd_round_cone(x, y, pcx, pcy, cx, cy, pr, r));
        pcx = cx; pcy = cy; pr = r;
    }

    // the strong flicker pinches a small tongue off the tip: it grows out of the tip (frame 23), separates (24),
    // rises, shrinks and fades (25-27)
    float pu = (wraps(T, 0.36) + 0.012) / 0.072;            // 0..1 over ~4.6 frames
    float piece = 0.0;
    float ytip = ybot + L;
    if (pu > 0.0 && pu < 1.0) {
        float lift = -0.035 + 0.30 * pu + 0.25 * pu * pu;
        float bx = sway_x(T, ev, 1.15);
        float rb = 0.040 * (W / 0.2) * (1.0 - 0.55 * pu);
        float sdb = sd_round_cone(x, y, bx, ytip + lift, bx * 1.05, ytip + lift + 0.11 * (1.0 - 0.4 * pu),
                                  rb, 0.2 * rb + 0.003);
        sd = smin(sd, sdb, 0.045 * (1.0 - smoothstep(0.15, 0.4, pu)) + 0.002);
        piece = (1.0 - smoothstep(0.35, 1.0, pu)) ;
    }
    float inside = -sd;
    float s = clamp((y - ybot) / L, 0.0, 1.0);

    // colour: layers follow the outline (constant thin red edge), white-yellow core low in the belly
    float d = max(inside, 0.0);
    float heat = 1.0 - exp(-d / 0.075);
    heat *= 1.0 - 0.30 * smoothstep(0.45, 1.0, s);
    float core = smoothstep(0.10, 0.17, d) * smoothstep(0.08, 0.22, s) * (1.0 - smoothstep(0.36, 0.60, s));
    heat = clamp(heat * 0.92 + 0.22 * core, 0.0, 1.0);
    float shim = pnoise(point(x * 7.0, y * 3.0 - T * 6.0, 0.5), point(64.0, 6.0, 64.0));   // periodic scroll
    heat = clamp(heat * (1.0 + 0.05 * shim), 0.0, 1.0);
    color col = candle_ramp(heat);
    // thin blue rim at the very base (real candle), fading in above the wick
    float base = 1.0 - smoothstep(0.015, 0.11, s);
    col = mix(col, color(0.22, 0.42, 1.0), 0.75 * base * (1.0 - smoothstep(0.0, 0.035, d)));
    // just outside the outline keep the deep edge colour (filtered edges never go dark or change hue)

    // alpha
    float e = 0.020;
    float A = smoothstep(-e, e, inside);
    A *= mix(0.50, 1.0, smoothstep(0.0, 0.14, s));          // translucent base
    A *= 1.0 - 0.25 * smoothstep(0.82, 1.0, s);             // translucent tip
    // the pinched-off piece (above the tip) fades as it rises
    A *= mix(1.0, piece, smoothstep(ytip - 0.01, ytip + 0.05, y) * step(0.0, pu) * step(pu, 1.0));
    A *= border(x, y, 0.07);

    Out = (mode == 0) ? col : color(A);
}
