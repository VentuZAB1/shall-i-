// SLINGSHOT Halloween - SmokeWisp 4x4 flipbook as a real lit VOLUME (vfx.py prepends common.h; one frame per render).
// A soft dark-grey smoke puff (3D density in a 2x2x2 cube) that rises a little in the frame, rolls like a vortex ring
// (rising core, the outer flanks curl outward and down), is domain-warped into soft cauliflower billows, and
// dissipates (it thins, tears into wisps and fades). Rendered by Cycles with a sun + sky ambient, so the lighting and
// self-shadowing are real. The particle's own Speed/Rotation/Size do most of the rising, so the puff stays near the
// middle of each frame and the 16 steps change gradually. Noise lives in puff-relative space (it expands with the puff).

point vwarp(point v, float seed)
{
    float wx = fbm(v * 1.1 + point(0.0, 0.0, seed), 3, 0.5);
    float wy = fbm(v * 1.1 + point(5.2, 1.3, seed), 3, 0.5);
    float wz = fbm(v * 1.1 + point(9.1, 7.7, seed), 3, 0.5);
    return v + 0.32 * vector(wx, wy, wz);
}

float puff3d(point p, float tt, float seed)
{
    float R = 0.48 + 0.36 * pow(tt, 0.85);
    point c = point(0.0, -0.10 + 0.12 * tt, 0.0);
    vector v = (p - c) / R;
    // vortex-ring roll in the (radius, height) half-plane around the ring core (0.62, 0.15)
    float rho = hypot(v[0], v[2]);
    float ca = (rho > 1e-4) ? v[0] / rho : 1.0;
    float sa = (rho > 1e-4) ? v[2] / rho : 0.0;
    float a0 = rho - 0.62, b0 = v[1] - 0.15;
    float ang = (0.25 + 1.0 * tt) * exp(-(a0 * a0 + b0 * b0) / 0.30);
    float cs = cos(ang), sn = sin(ang);
    float a1 = cs * a0 - sn * b0, b1 = sn * a0 + cs * b0;
    float r2 = abs(a1 + 0.62);                 // reflect (no seam on the axis)
    point q = point(r2 * ca, b1 + 0.15, r2 * sa);
    q = vwarp(q, seed + 0.25 * tt);
    // body: a cap a little wider than tall, a narrower tail underneath
    float qy = q[1];
    float body = 1.0 - smoothstep(0.40, 1.0, length(vector(q[0] / 1.05, qy * (qy < 0.0 ? 1.12 : 0.98), q[2] / 1.05)));
    float lobes = billow(q * 1.45 + point(seed, 0.0, 0.3 * tt), 3, 0.45);           // big cauliflower lobes
    float detail = fbm(q * 4.6 + point(0.0, seed, 0.5 * tt), 4, 0.55);              // fine billows / wisps
    float ero = 0.42 * pow(tt, 1.2);
    return body * (0.15 + 1.45 * lobes) + (0.16 + 0.22 * tt) * detail - 0.62 - ero;
}

shader smoke_volume(int frame = 0, int frames = 16, float seed = 11.1, float density = 55.0,
                    output float Density = 0, output color Albedo = 0.3)
{
    point p = transform("object", P);
    float tt = frame / (frames - 1.0);
    float d = puff3d(p, tt, seed);
    float thin = (1.0 - 0.80 * smoothstep(0.25, 1.0, tt)) * (1.0 - 0.85 * smoothstep(0.6, 1.0, tt));
    Density = density * max(d, 0.0) * thin * border(p[0], p[1], 0.10);
    Albedo = color(0.46, 0.45, 0.47);
}
