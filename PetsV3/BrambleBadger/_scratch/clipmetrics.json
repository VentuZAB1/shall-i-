 "_definitions": {
  "swing_max_all / swing_max_limb": "[deg, bone, frame]: the largest change between two adjacent frames (f-1 -> f, step 1) of a bone's ARMATURE-SPACE orientation (pose_bone.matrix rotation, so it includes the parents' motion = the limb as seen in the world), over every bone / over Leg_*, Shin_*, Foot_*, Claw* bones. Limit ~60 deg.",
  "swing_local_max": "[deg, bone, frame]: the same, but of the bone's LOCAL rotation (pose_bone.rotation_quaternion, relative to its parent) - comparable to decoding the raw keyed / exported bone quaternions.",
  "quat_flips_keys": "consecutive rotation_quaternion keys of one bone with a 4D dot product < 0 (a sign flip), all bones",
  "quat_flips_sampled": "the same test on the evaluated local quaternion at every frame",
  "chest_vs_spine_max": "largest rotation angle of the Chest bone's local rotation (= the bend between chest and spine)",
  "neck_max": "largest rotation angle of the Neck bone's local rotation",
  "head_pitch_up_world_max": "largest rise (deg) of the Head bone's direction above its rest elevation, world space",
  "head_yaw_rate_max": "[deg, frame]: largest change of the Head bone's world heading between adjacent frames",
  "end": "fN_vs_f0 / fN_vs_idle_f0 = [max local rotation diff deg, max location diff, bone] of the last frames vs the clip's own frame 0 / vs the idle's frame 0; fN_vs_bind = vs the bind pose (the planted-leg solve sits ~4.6 deg off bind)"
 }
}